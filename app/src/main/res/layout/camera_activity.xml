<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".CameraActivity">

    <!-- Full-screen Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter" />

    <!-- Document Alignment Overlay Guidelines -->
    <View
        android:id="@+id/overlayGuideTop"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#80FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/overlayGuideBottom"
        app:layout_constraintVertical_bias="0.25"
        android:alpha="0.5" />

    <View
        android:id="@+id/overlayGuideBottom"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#80FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/overlayGuideTop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.75"
        android:alpha="0.5" />

    <View
        android:id="@+id/overlayGuideLeft"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#80FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/overlayGuideRight"
        app:layout_constraintHorizontal_bias="0.15"
        android:alpha="0.5" />

    <View
        android:id="@+id/overlayGuideRight"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#80FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/overlayGuideLeft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.85"
        android:alpha="0.5" />

    <!-- Corner indicators for document alignment -->
    <View
        android:id="@+id/cornerTopLeft"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/corner_indicator"
        app:layout_constraintTop_toTopOf="@id/overlayGuideTop"
        app:layout_constraintStart_toStartOf="@id/overlayGuideLeft"
        android:alpha="0.6" />

    <View
        android:id="@+id/cornerTopRight"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/corner_indicator"
        android:rotation="90"
        app:layout_constraintTop_toTopOf="@id/overlayGuideTop"
        app:layout_constraintEnd_toEndOf="@id/overlayGuideRight"
        android:alpha="0.6" />

    <View
        android:id="@+id/cornerBottomLeft"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/corner_indicator"
        android:rotation="270"
        app:layout_constraintBottom_toBottomOf="@id/overlayGuideBottom"
        app:layout_constraintStart_toStartOf="@id/overlayGuideLeft"
        android:alpha="0.6" />

    <View
        android:id="@+id/cornerBottomRight"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/corner_indicator"
        android:rotation="180"
        app:layout_constraintBottom_toBottomOf="@id/overlayGuideBottom"
        app:layout_constraintEnd_toEndOf="@id/overlayGuideRight"
        android:alpha="0.6" />

    <!-- Document alignment hint text -->
    <TextView
        android:id="@+id/tvAlignmentHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/align_document_hint"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:background="#80000000"
        android:padding="12dp"
        android:gravity="center"
        android:drawablePadding="8dp"
        app:drawableTopCompat="@android:drawable/ic_menu_info_details"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp"
        android:visibility="visible" />

    <!-- Top Control Bar (Semi-transparent) -->
    <View
        android:id="@+id/topBarBackground"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/gradient_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Back Button (Top Left) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:icon="@android:drawable/ic_menu_close_clear_cancel"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="@android:color/white"
        app:cornerRadius="24dp"
        app:strokeWidth="0dp"
        android:backgroundTint="#40000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:contentDescription="@string/back_button" />

    <!-- Flash Toggle Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFlash"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:icon="@android:drawable/ic_menu_gallery"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="@android:color/white"
        app:cornerRadius="24dp"
        app:strokeWidth="0dp"
        android:backgroundTint="#40000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/flash_toggle" />

    <!-- Bottom Control Bar (Semi-transparent) -->
    <View
        android:id="@+id/bottomBarBackground"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/gradient_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Gallery Button (Bottom Right) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGallery"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:icon="@android:drawable/ic_menu_gallery"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="28dp"
        app:iconTint="@android:color/white"
        app:cornerRadius="28dp"
        app:strokeWidth="2dp"
        app:strokeColor="@android:color/white"
        android:backgroundTint="#60000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="32dp"
        android:contentDescription="@string/open_gallery" />

    <!-- Capture Button (Bottom Center) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCapture"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_menu_camera"
        app:tint="@android:color/white"
        app:fabSize="auto"
        app:fabCustomSize="80dp"
        app:maxImageSize="40dp"
        app:borderWidth="4dp"
        app:elevation="6dp"
        app:pressedTranslationZ="12dp"
        app:rippleColor="@android:color/white"
        app:backgroundTint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/capture_document" />

    <!-- Last Captured Image Preview (Bottom Left) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLastImage"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:strokeWidth="2dp"
        app:strokeColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivLastCaptured"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/last_captured_image"
            tools:src="@android:drawable/ic_menu_gallery" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Document Count Badge -->
    <TextView
        android:id="@+id/tvDocumentCount"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/badge_circle"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/cardLastImage"
        app:layout_constraintEnd_toEndOf="@id/cardLastImage"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="-8dp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="3" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@android:color/white"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- Capture Status Message -->
    <TextView
        android:id="@+id/tvCaptureStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/processing_image"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:background="#CC000000"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>

